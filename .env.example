# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email Sender Info
FROM_EMAIL=your-email@gmail.com
FROM_NAME=NJMTech

# Template Variables
SENDER_NAME=Your Full Name
CONTACT_EMAIL=your-email@gmail.com

# Deployment Profile
# shared = multiple clients on one deployment (default)
# dedicated = single client locked to CLIENT_KEY
DEPLOYMENT_TIER=shared
ALLOWED_CLIENTS=default,style-and-grace,bookmark-sync-engine
# CLIENT_KEY=bookmark-sync-engine

# Email delivery mode: auto | render | send
EMAIL_MODE=auto

# Authentication (required in production when keys are set)
# Shared tier: one key for all clients, or per-client map via API_KEYS
API_KEY=
# API_KEYS={"default":"key-for-default","style-and-grace":"key-for-sg"}

# Dedicated tier example:
# DEPLOYMENT_TIER=dedicated
# CLIENT_KEY=bookmark-sync-engine
# API_KEY=your-dedicated-client-key
# EMAIL_MODE=send

# Rate limiting (optional JSON override)
# RATE_LIMIT={"windowMs":900000,"max":100}

# Distributed rate limiting (recommended for production/serverless)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Preview routes (disabled by default on dedicated deployments)
# PREVIEW_ENABLED=true

# Force auth off for local development
# AUTH_REQUIRED=false

# Template Admin UI (/admin)
ADMIN_API_KEY=
# ADMIN_ENABLED=false
# ADMIN_REQUIRED=true
