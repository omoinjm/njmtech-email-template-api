# Dedicated deployment env template for bookmark-sync-engine (Tier 2)
# Copy these values into a new Vercel project: email-api-bse

DEPLOYMENT_TIER=dedicated
CLIENT_KEY=bookmark-sync-engine
EMAIL_MODE=send
API_KEY=replace-with-strong-secret
PREVIEW_ENABLED=false
RATE_LIMIT={"windowMs":86400000,"max":10000}

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=Bookmark Sync Engine
CONTACT_EMAIL=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
